# Dishbee runtime
DISHBEE_SUPABASE_URL=
DISHBEE_SUPABASE_ANON_KEY=

# MealDeck is ONE Dishbee tenant, with two distinct location IDs.
# Use the actual UUIDs from Dishbee /landlord/tenant-launch; do not guess IDs.
# Set server-side only; missing/conflicting IDs leave live checkout unavailable.
MEALDECK_TENANT_ID=
MEALDECK_LUTON_LOCATION_ID=
MEALDECK_STALBANS_LOCATION_ID=

# Backwards-compatible legacy tenant settings, if currently used.
# If supplied, BOTH must equal MEALDECK_TENANT_ID and each other.
# Do not configure separate Luton and St Albans tenants for MealDeck.
MEALDECK_LUTON_TENANT_ID=
MEALDECK_STALBANS_TENANT_ID=

# Payment provider is deliberately separate from Dishbee public credentials.
# Add only server-side payment secrets when the MealDeck payment provider is selected.

# Franchise enquiry service: set the complete deployed public API URL, including
# /api/public/network-expansion. Server-side only; never use a VITE_ prefix.
# The endpoint must accept the current offer acknowledgements and store enquiries.
OMNIQORA_PUBLIC_API_URL=

# Optional Dishbee server-to-server payment bridge (server environment ONLY).
# Use the same approved Dishbee API origin configured as DISHBEE_PUBLIC_ORIGIN.
# Do not set these until the Dishbee migration and hosted checkout acceptance pass.
DISHBEE_APP_URL=
# High-entropy value (>=32 chars) matching Dishbee's DISHBEE_MEALDECK_CHECKOUT_TOKEN.
# Never expose in VITE_ settings or client-side JavaScript.
MEALDECK_CHECKOUT_TOKEN=
