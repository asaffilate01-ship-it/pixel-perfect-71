# Dishbee runtime
DISHBEE_SUPABASE_URL=
DISHBEE_SUPABASE_ANON_KEY=

# MealDeck locations
MEALDECK_LUTON_TENANT_ID=
MEALDECK_LUTON_LOCATION_ID=
MEALDECK_STALBANS_TENANT_ID=
MEALDECK_STALBANS_LOCATION_ID=

# Payment provider is deliberately separate from Dishbee public credentials.
# Add only server-side payment secrets when the MealDeck payment provider is selected.

# Franchise enquiry service: set the complete deployed public API URL, including
# /api/public/network-expansion. Server-side only; never use a VITE_ prefix.
# The endpoint must accept the current offer acknowledgements and store enquiries.
OMNIQORA_PUBLIC_API_URL=

# Optional human-assisted WhatsApp basket enquiry (NOT automated ordering).
# Only enable after the public launch gate is lifted, the official channel is
# connected to the correct Omniqora/Dishbee tenant/location and the real
# cross-brand chat -> payment -> KDS staging journey has been signed off.
# A browser receives the verified PUBLIC business number only, never credentials.
MEALDECK_WHATSAPP_ASSISTANCE_ENABLED=false
MEALDECK_LUTON_WHATSAPP_BUSINESS_NUMBER=
MEALDECK_LUTON_WHATSAPP_VERIFIED=false
MEALDECK_STALBANS_WHATSAPP_BUSINESS_NUMBER=
MEALDECK_STALBANS_WHATSAPP_VERIFIED=false


# MealDeck /ops private staff console (public/publishable client key ONLY).
# These must point to the APPROVED existing Dishbee Supabase project
# containing canonical tenants, orders, menus and two staged ops migrations.
# Never use a service_role key or an admin API secret in VITE_ settings.
VITE_MEALDECK_OPS_SUPABASE_URL=
VITE_MEALDECK_OPS_SUPABASE_ANON_KEY=
# Staff Auth users and RBAC grants must be provisioned explicitly by an
# authorised operator; the app never creates users automatically.
