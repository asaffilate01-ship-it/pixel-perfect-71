# MealDeck's independent database. Set this pair on the application server.
# Both customer server functions and the private /ops + /kds staff client use
# this exact connection. The staff bootstrap exposes only these public values.
# Use the HTTPS project origin and its sb_publishable_ key (or legacy anon JWT).
# Never put a secret/service_role key in MEALDECK_SUPABASE_PUBLISHABLE_KEY.
MEALDECK_SUPABASE_URL=
MEALDECK_SUPABASE_PUBLISHABLE_KEY=
# Legacy DISHBEE_SUPABASE_* and VITE_MEALDECK_* credentials are NOT fallbacks.
# Remove them when migrating; a conflicting old URL/key fails closed. Matching
# aliases are tolerated only for migration. Generic SUPABASE_* is not read.

# One MealDeck business with its own kitchen/location records. Current shared
# kitchen: all brands on one KDS board. Future kitchens need separate IDs.
# Use the UUIDs provisioned in the independent MealDeck project; never invent IDs.
MEALDECK_TENANT_ID=
MEALDECK_LUTON_LOCATION_ID=
MEALDECK_STALBANS_LOCATION_ID=
# Optional legacy aliases during migration only. If supplied, they MUST
# equal MEALDECK_TENANT_ID; conflicts disable live checkout.
MEALDECK_LUTON_TENANT_ID=
MEALDECK_STALBANS_TENANT_ID=

# Payment provider credentials are separate from the public database connection.
# Add only server-side payment secrets when the MealDeck payment provider is selected.

# Franchise enquiry service: set the complete deployed public API URL, including
# /api/public/network-expansion. Server-side only; never use a VITE_ prefix.
# The endpoint must accept the current offer acknowledgements and store enquiries.
OMNIQORA_PUBLIC_API_URL=

# Optional human-assisted WhatsApp basket enquiry (NOT automated ordering).
# Only enable after the public launch gate is lifted, the official channel is
# connected to the correct Omniqora channel and MealDeck kitchen and the real
# cross-brand chat -> payment -> KDS staging journey has been signed off.
# A browser receives the verified PUBLIC business number only, never credentials.
MEALDECK_WHATSAPP_ASSISTANCE_ENABLED=false
MEALDECK_LUTON_WHATSAPP_BUSINESS_NUMBER=
MEALDECK_LUTON_WHATSAPP_VERIFIED=false
MEALDECK_STALBANS_WHATSAPP_BUSINESS_NUMBER=
MEALDECK_STALBANS_WHATSAPP_VERIFIED=false


# MealDeck /ops and /kds share the server pair above; do not configure a second
# browser database. Install the independent profile documented in
# docs/mealdeck-independent-backend-phase47.md on a fresh MealDeck project.
# Staff Auth users and RBAC grants must be provisioned explicitly by an
# authorised operator; the app never creates users automatically.

# Courier tracking: exact, verified HTTPS hostnames ONLY (server-side).
# Comma-separated hostnames; never specify URL schemes, wildcards or secrets.
# Leave blank until provider domains are independently verified.
# An empty value hides external tracking links; MealDeck's own tracking remains.
MEALDECK_TRACKING_ALLOWED_HOSTS=

# Additional server-only kill switch for future live customer checkout.
# Keep empty until an independently approved MealDeck payment-session endpoint,
# provider-signed webhooks, group capture, KDS and delivery acceptance
# have passed an end-to-end staging rehearsal. This flag alone connects NO
# Adyen session and MUST NOT be treated as evidence of provider readiness.
MEALDECK_CHECKOUT_INTEGRATION_APPROVED=

# Server-only HMAC secret for short-lived basket estimates. Minimum 32 bytes,
# high entropy, never exposed in VITE_ variables or client logs.
# A quote is NOT a payment session or an Adyen/courier guarantee.
# Leave unset until the approved MealDeck staging/release rehearsal.
MEALDECK_QUOTE_SIGNING_SECRET=

# Future checkout: server ONLY, privileged credential from this SAME MealDeck
# project. Accepts sb_secret_ or a matching legacy service_role JWT. Opaque keys
# must be provisioned and verified from the same project by the operator.
# No fallback to DISHBEE_MEALDECK_CHECKOUT_SERVER_KEY or any browser key.
# Leave unset: the standalone profile intentionally does not provide payment
# checkout RPCs, provider sessions or verified kitchen release evidence yet.
# Requires reviewed server pricing, request limits, signed provider events and
# an end-to-end payment/capture/KDS rehearsal before the release gates change.
# Never put a real value in VITE_* / browser settings, logs, examples or PRs.
MEALDECK_CHECKOUT_SERVER_KEY=
