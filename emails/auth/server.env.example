# Server-only. Keep false until the same MealDeck Auth host supports and is configured for this hook.
MEALDECK_AUTH_EMAIL_ENABLED=false
RESEND_API_KEY=
MEALDECK_AUTH_EMAIL_FROM=
MEALDECK_AUTH_EMAIL_HOOK_SECRET=
MEALDECK_AUTH_EMAIL_PREVIOUS_HOOK_SECRET=
# Reuse the existing paired MEALDECK_SUPABASE_URL / MEALDECK_SUPABASE_PUBLISHABLE_KEY.
# Do not copy credentials into templates, browser variables or source control.
