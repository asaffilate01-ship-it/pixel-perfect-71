{
  "name": "@mealdeck/terminal",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "node scripts/prebuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:config": "expo config --type public",
    "export:check": "expo export --platform android --platform ios --output-dir dist --max-workers 2",
    "check:native": "node scripts/check-native.mjs"
  },
  "dependencies": {
    "@stripe/stripe-terminal-react-native": "0.0.1-beta.34",
    "@supabase/supabase-js": "2.118.0",
    "expo": "56.0.24",
    "expo-build-properties": "56.0.27",
    "expo-constants": "56.0.27",
    "expo-crypto": "56.0.5",
    "expo-dev-client": "56.0.28",
    "expo-modules-core": "56.0.27",
    "expo-network": "56.0.5",
    "expo-screen-capture": "56.0.5",
    "expo-secure-store": "56.0.4",
    "expo-status-bar": "56.0.4",
    "expo-system-ui": "56.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-url-polyfill": "3.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "expo-template-bare-minimum": "56.0.24",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
