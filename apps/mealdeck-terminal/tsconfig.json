{
  "extends": "expo/tsconfig.base",
  "compilerOptions": { "strict": true, "noUncheckedIndexedAccess": true, "types": ["react"] },
  "include": [
    "App.tsx",
    "index.ts",
    "app.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts"
  ],
  "exclude": ["node_modules", "android", "ios", "tests"]
}
